#!/usr/bin/env bash
# wts — launch/control worktree-studio. Installed by install/install.sh to
# ~/.worktree-studio/bin/wts (symlinked into ~/.local/bin).
#   wts web | tui | desktop     open that front end (starts the server if needed)
#   wts start|stop|restart|status|logs   control the background server
#   wts install-service|uninstall-service  run the server at login (launchd / systemd --user)
#   wts dev                     Vite hot reload (only from a repo checkout)
set -euo pipefail
D="$HOME/.worktree-studio"; BIN="$D/bin"; ADDR_FILE="$D/server.addr"
LABEL=com.worktree-studio.server
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
UNIT="$HOME/.config/systemd/user/worktree-studio.service"
case "$(uname -s)" in Darwin) OS=macos ;; *) OS=linux ;; esac

alive() { [ -f "$ADDR_FILE" ] && curl -fs -o /dev/null --max-time 1 "http://$(cat "$ADDR_FILE")/api/repos"; }
has_service() { [ -f "$PLIST" ] || [ -f "$UNIT" ]; }

svc() { # start | stop
  if [ "$OS" = macos ]; then
    if [ "$1" = start ]; then launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl kickstart "gui/$(id -u)/$LABEL"
    else launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true; fi
  else systemctl --user "$1" worktree-studio; fi
}

start() {
  alive && return
  rm -f "$ADDR_FILE"; mkdir -p "$D"
  if has_service; then svc start
  else nohup "$BIN/worktree-studio" >/dev/null 2>&1 & fi   # logs go to $D/server.log by themselves
  for _ in $(seq 50); do alive && return; sleep 0.2; done
  echo "server did not come up; see $D/server.log" >&2; exit 1
}

stop() {
  if has_service; then svc stop; else pkill -f "$BIN/worktree-studio\$" || true; fi
  rm -f "$ADDR_FILE"
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  alive && echo "running: http://$(cat "$ADDR_FILE")" || { echo "not running"; exit 1; } ;;
  logs)    exec tail -f "$D/server.log" ;;
  web)     start; open "http://$(cat "$ADDR_FILE")" 2>/dev/null || xdg-open "http://$(cat "$ADDR_FILE")" ;;
  tui)     start; WORKTREE_STUDIO_ADDR="$(cat "$ADDR_FILE")" exec "$BIN/wts-tui" ;;
  desktop) start; [ "$OS" = macos ] || { echo "desktop app is macOS-only" >&2; exit 1; }
           open "$HOME/Applications/Worktree Studio.app" ;;
  dev)     root="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
           [ -f "$root/go.mod" ] || { echo "dev needs a repo checkout" >&2; exit 1; }
           start; cd "$root/web"; WORKTREE_STUDIO_ADDR="$(cat "$ADDR_FILE")" exec bun run dev --open ;;
  install-service)
    stop
    if [ "$OS" = macos ]; then
      mkdir -p "$(dirname "$PLIST")"
      cat > "$PLIST" <<P
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$BIN/worktree-studio</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$PATH</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
P
    else
      mkdir -p "$(dirname "$UNIT")"
      cat > "$UNIT" <<U
[Unit]
Description=worktree-studio server
[Service]
ExecStart=$BIN/worktree-studio
Environment=PATH=$PATH
Restart=on-failure
[Install]
WantedBy=default.target
U
      systemctl --user daemon-reload; systemctl --user enable worktree-studio
    fi
    start; echo "service installed; server runs at login" ;;
  uninstall-service)
    stop; rm -f "$PLIST" "$UNIT"
    [ "$OS" = linux ] && { systemctl --user disable worktree-studio 2>/dev/null || true; systemctl --user daemon-reload 2>/dev/null || true; }
    echo "service removed" ;;
  *) echo "usage: wts {web|tui|desktop|dev|start|stop|restart|status|logs|install-service|uninstall-service}"; exit 2 ;;
esac
